@{
    ViewData["Title"] = "Logowanie";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-4">
            <div class="card shadow-sm">
                <div class="card-header rusty-background text-white text-center">
                    <h3 class="mb-0">Logowanie</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Login" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="email" class="form-label fw-bold">Email</label>
                            <input type="email" name="email" id="email" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label fw-bold">Hasło</label>
                            <input type="password" name="password" id="password" class="form-control" required />
                        </div>

                        <div class="form-check mb-3">
                            <input type="checkbox" name="rememberMe" id="rememberMe" class="form-check-input" />
                            <label for="rememberMe" class="form-check-label">Zapamiętaj mnie</label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary w-50 mx-auto">Zaloguj się</button>
                        </div>
                    </form>
                </div>
            </div>

            <p class="mt-3 text-center">
                Nie masz konta? <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Zarejestruj się</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}